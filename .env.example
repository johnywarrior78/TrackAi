DATABASE_URL=postgresql+psycopg://aivi:change-me@localhost:5432/aivi
POSTGRES_PASSWORD=change-me
REPORT_DIR=reports
LOG_DIR=logs
SCHEDULE_HOUR=7
SCHEDULE_MINUTE=0
HTTP_TIMEOUT=30
HTTP_RETRIES=4
REQUEST_INTERVAL=1.0
GITHUB_TOKEN=
CVE_REPO_PATH=
ENRICHMENT_LIMIT=500
PRIORITY_CONFIG=config/priority.yml
ANTHROPIC_SNAPSHOTS=2026-05-22-1027,2026-08-26-1155

EPSS_BULK_THRESHOLD=1000
CACHE_DIR=.cache

# First-run installers/dashboard/scheduler populate all source-supported history.
AUTO_BACKFILL=true
HISTORY_BATCH_SIZE=1000
CVE_ARCHIVE_MAX_BYTES=2147483648
